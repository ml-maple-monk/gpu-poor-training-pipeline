# Dockerfile.remote — remote training image for Verda/dstack H100 runs
#
# Base: slim shared training runtime image from Dockerfile.base
# Target: thin repo layer on top of the shared training base
#
# DO NOT MODIFY training/docker/Dockerfile.train — that file is local-only.
# This file is the source of truth for the remote image.

ARG BASE_IMAGE=verda-training-base:py312-cu128-slim
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/workspace/hf_cache \
    HF_HUB_ENABLE_HF_TRANSFER=0 \
    TRANSFORMERS_OFFLINE=0 \
    TOKENIZERS_PARALLELISM=false \
    PYTHONPATH=/opt/training/shared:/opt/training/vendor/minimind_mfu_working

RUN apt-get update && apt-get install -y --no-install-recommends gcc python3.12-dev openssh-server && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /var/run/sshd /root/.ssh \
    && chmod 700 /root/.ssh

# doc-anchor: remote-dockerfile-ssh-bake
# Inject operator's SSH pubkey at build time (ARG) — empty value disables sshd.
ARG SSH_PUBKEY=""
RUN if [ -n "$SSH_PUBKEY" ]; then \
        echo "$SSH_PUBKEY" > /root/.ssh/authorized_keys && \
        chmod 600 /root/.ssh/authorized_keys; \
    fi

# Bake repo-owned training source (no runtime git clone). Dataset and tokenizer
# artifacts are intentionally not baked; remote-entrypoint.sh pulls them from R2
# after the container is running.
COPY training/src/minimind/ /opt/training/minimind/
COPY training/vendor/minimind_mfu_working/ /opt/training/vendor/minimind_mfu_working/
COPY src/gpupoor/ /opt/training/shared/gpupoor/

# Bake training scripts
COPY training/scripts/lib/hf-dataset-bootstrap.sh /opt/training/scripts/lib/hf-dataset-bootstrap.sh
COPY training/scripts/lib/portable-mlflow.sh /opt/training/scripts/lib/portable-mlflow.sh
COPY training/scripts/pull-r2-tokenized-dataset.py /opt/training/scripts/pull-r2-tokenized-dataset.py
COPY training/scripts/pretokenize-data.sh /opt/training/scripts/pretokenize-data.sh
COPY training/scripts/run-vendor-minimind.py /opt/training/scripts/run-vendor-minimind.py
COPY training/scripts/sync-mlflow-bundle.py /opt/training/scripts/sync-mlflow-bundle.py
COPY training/scripts/remote-entrypoint.sh /opt/training/scripts/remote-entrypoint.sh
COPY defaults.toml /opt/training/defaults.toml
RUN chmod +x \
        /opt/training/scripts/remote-entrypoint.sh \
        /opt/training/scripts/pull-r2-tokenized-dataset.py \
        /opt/training/scripts/pretokenize-data.sh \
        /opt/training/scripts/run-vendor-minimind.py \
        /opt/training/scripts/sync-mlflow-bundle.py \
        /opt/training/scripts/lib/hf-dataset-bootstrap.sh \
        /opt/training/scripts/lib/portable-mlflow.sh

# Workspace layout expected by the entrypoint
RUN mkdir -p /workspace/data/datasets /workspace/out /workspace/hf_cache

WORKDIR /opt/training/vendor/minimind_mfu_working

# Default: verify torch and the vendored trainer package
CMD ["python", "-c", "import minimind_local, torch; print(minimind_local.__name__, torch.__version__, torch.cuda.is_available())"]
