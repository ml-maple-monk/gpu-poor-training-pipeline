ARG BUILDER_IMAGE=nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04
ARG RUNTIME_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

FROM ${BUILDER_IMAGE} AS builder

RUN echo "$BUILDER_IMAGE" | grep -vq ':latest$'

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    HF_HOME=/workspace/hf_cache \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    TRANSFORMERS_OFFLINE=0 \
    TOKENIZERS_PARALLELISM=false \
    VLLM_WORKER_MULTIPROC_METHOD=spawn \
    DS_BUILD_OPS=0 \
    CUDA_HOME=/usr/local/cuda \
    VENV_PATH=/opt/venv \
    UV_PROJECT_ENVIRONMENT=/opt/venv

ARG TORCH_CUDA_INDEX_URL=https://download.pytorch.org/whl/cu128
ARG MAX_JOBS=8

ENV MAX_JOBS=${MAX_JOBS}

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        ffmpeg \
        git \
        git-lfs \
        jq \
        libaio-dev \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libnuma1 \
        libopenmpi-dev \
        ninja-build \
        openssh-client \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        rsync \
        wget \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv "${VENV_PATH}"

ENV PATH="/root/.local/bin:${VENV_PATH}/bin:${PATH}"

WORKDIR /workspace

RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Copy source and package metadata only. Runtime dataset and tokenizer artifacts
# are excluded by .dockerignore and pulled from R2 by remote-entrypoint.sh.
COPY training/vendor/minimind_mfu_working/ /opt/training/vendor/minimind_mfu_working/

WORKDIR /opt/training/vendor/minimind_mfu_working

RUN uv sync --frozen --no-dev \
    && python -m pip install --no-compile "boto3>=1.34,<2" \
    && nvcc --version \
    && find "${VENV_PATH}" -type d -name '__pycache__' -prune -exec rm -rf '{}' + \
    && find "${VENV_PATH}" -type f \( -name '*.pyc' -o -name '*.pyo' -o -name '*.a' -o -name '*.o' \) -delete \
    && python - <<'PY'
import flash_attn
import minimind_local
import torch

print(
    {
        "flash_attn": getattr(flash_attn, "__version__", "unknown"),
        "minimind_local": minimind_local.__name__,
        "torch": torch.__version__,
        "cuda": torch.version.cuda,
        "gpu": torch.cuda.is_available(),
        "cxx11abi": torch._C._GLIBCXX_USE_CXX11_ABI,
    }
)
PY

FROM ${RUNTIME_IMAGE} AS runtime

RUN echo "$RUNTIME_IMAGE" | grep -vq ':latest$'

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    HF_HOME=/workspace/hf_cache \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    TRANSFORMERS_OFFLINE=0 \
    TOKENIZERS_PARALLELISM=false \
    VLLM_WORKER_MULTIPROC_METHOD=spawn \
    DS_BUILD_OPS=0 \
    CUDA_HOME=/usr/local/cuda \
    VENV_PATH=/opt/venv \
    PYTHONPATH=/opt/training/vendor/minimind_mfu_working \
    PATH=/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ffmpeg \
        git \
        git-lfs \
        jq \
        libaio1t64 \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libnuma1 \
        libopenmpi3t64 \
        openssh-client \
        python3 \
        rsync \
        wget \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
# Copy the installed source tree without dataset/tokenizer artifacts.
COPY --from=builder /opt/training/vendor/minimind_mfu_working/ /opt/training/vendor/minimind_mfu_working/

WORKDIR /workspace

RUN python - <<'PY'
import flash_attn
import minimind_local
import torch
import transformers
import tqdm

print(
    {
        "flash_attn": getattr(flash_attn, "__version__", "unknown"),
        "minimind_local": minimind_local.__name__,
        "torch": torch.__version__,
        "cuda": torch.version.cuda,
        "gpu": torch.cuda.is_available(),
        "transformers": transformers.__version__,
        "tqdm": tqdm.__version__,
    }
)
PY

CMD ["python", "-c", "import minimind_local, torch, transformers, tqdm; print({'minimind_local': minimind_local.__name__, 'torch': torch.__version__, 'cuda': torch.version.cuda, 'gpu': torch.cuda.is_available(), 'transformers': transformers.__version__, 'tqdm': tqdm.__version__})"]
