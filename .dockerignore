!training/vendor/minimind_mfu_working/minimind_local/data/**
training/vendor/minimind_mfu_working/data/**
!training/vendor/minimind_mfu_working/data/
!training/vendor/minimind_mfu_working/data/tokenizers/
!training/vendor/minimind_mfu_working/data/tokenizers/native_superbpe_1m_rows_max4w/
.git/
.omc/
__pycache__
*.pyc
.pytest_cache
.gitignore
PARITY.md
README.md
!training/vendor/minimind_mfu_working/README.md
!training/vendor/minimind_mfu_working/data/tokenizers/native_superbpe_1m_rows_max4w/README.md
scripts/
Makefile
