    classDef external fill:#f3f4f6,stroke:#4b5563,color:#111827,stroke-width:1.5px;

    TOML["TOML config<br/>examples/*.toml + defaults.toml"]
    RUNCONFIG["RunConfig dataclasses<br/>src/gpupoor/config.py"]

    subgraph Orchestration["src/gpupoor orchestration"]
        CLI["gpupoor CLI"]
        DEPLOYER["deployer.py<br/>launch gates + connector readiness"]
        LOCAL["backends/local.py<br/>local process/container submission"]
        DSTACK["backends/dstack.py<br/>dstack policy + render/apply"]
        CONNECTOR["connector.py<br/>R2 readiness + artifact env"]
        PORTABLE["services/portable_mlflow.py<br/>bundle runtime env"]
    end

    subgraph TrainerCore["training/src/minimind/trainer/core"]
        SUBMISSION["submission.submit()"]
        EXECUTOR["executor.run()"]
