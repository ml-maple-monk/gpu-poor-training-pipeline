        CONFIG["pretrain_config.py<br/>merged TOML adapter"]
        DATA["dataset + collator"]
        MODEL["model graph"]
        METRICS["MLflow + MFU + checkpoint code"]
    end

    subgraph External["External systems"]
        DSTACKSYS["dstack server + GPU providers"]
        DOCKER["Docker / registry"]
        MLFLOW["Portable MLflow bundle<br/>SQLite + artifacts"]
